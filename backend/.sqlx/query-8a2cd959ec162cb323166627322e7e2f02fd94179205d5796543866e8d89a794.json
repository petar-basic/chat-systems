  "query": "\n            SELECT u.id, COALESCE(wm.display_name, u.display_name, '') AS \"name!\"\n              FROM workspace_members wm\n              JOIN users u ON u.id = wm.user_id\n             WHERE wm.workspace_id = $1 AND u.id = ANY($2)\n            ",
