{
  "db_name": "PostgreSQL",
  "query": "SELECT o.id, o.label, COUNT(v.user_id) AS \"votes!\"\n                 FROM poll_options o\n                 LEFT JOIN poll_votes v ON v.option_id = o.id\n                WHERE o.poll_id = $1\n                GROUP BY o.id, o.label, o.position\n                ORDER BY o.position",
