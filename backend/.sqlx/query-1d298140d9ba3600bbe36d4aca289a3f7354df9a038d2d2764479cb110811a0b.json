  "query": "\n            SELECT id, name, enabled, created_by\n              FROM workflows\n             WHERE workspace_id = $1\n               AND jsonb_path_exists(definition, 'strict $.**.channel_id ? (@ == $c)',\n                                     jsonb_build_object('c', $2::text))\n             ORDER BY lower(name)\n            ",
