  "query": "\n            SELECT id, workflow_id, workflow_version, status AS \"status: RunStatus\",\n                   context, error, started_at, finished_at\n              FROM workflow_runs\n             WHERE workflow_id = $1\n             ORDER BY started_at DESC, id\n             LIMIT $2\n            ",
