{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.id AS \"id!\",\n                   COALESCE(wm.display_name, u.display_name, split_part(u.email, '@', 1)) AS \"name!\"\n              FROM users u\n              LEFT JOIN workspace_members wm ON wm.user_id = u.id AND wm.workspace_id = $1\n             WHERE u.id = ANY($2)\n            ",
