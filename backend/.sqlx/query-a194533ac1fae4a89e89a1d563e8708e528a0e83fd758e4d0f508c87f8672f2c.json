  "query": "SELECT id, channel_id, user_id, client_message_id, CASE WHEN deleted_at IS NULL THEN content ELSE '' END AS \"content!\", CASE WHEN deleted_at IS NULL THEN metadata ELSE '{}'::jsonb END AS \"metadata!\", thread_parent_id, reply_count AS \"reply_count!\", is_pinned AS \"is_pinned!\", created_at, updated_at, deleted_at FROM messages WHERE id = $1 AND (deleted_at IS NULL OR reply_count > 0)",
