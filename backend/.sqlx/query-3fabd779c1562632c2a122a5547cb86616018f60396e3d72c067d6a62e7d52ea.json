{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT s.id,\n                   s.workspace_id,\n                   s.message_id,\n                   s.note,\n                   s.created_at,\n                   m.channel_id,\n                   m.user_id AS author_id,\n                   m.content,\n                   m.created_at AS sent_at\n            FROM saved_messages s\n            JOIN messages m ON m.id = s.message_id AND m.deleted_at IS NULL\n            WHERE s.user_id = $1\n              AND s.workspace_id = $2\n            ORDER BY s.created_at DESC\n            ",
