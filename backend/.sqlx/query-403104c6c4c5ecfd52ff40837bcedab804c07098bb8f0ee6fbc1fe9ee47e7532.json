  "db_name": "PostgreSQL",
  "query": "\n            UPDATE drafts\n               SET content = '', files_left_behind = FALSE, updated_at = NOW()\n             WHERE user_id = $1\n               AND channel_id = $2\n               AND thread_parent_id IS NOT DISTINCT FROM $3\n               AND content <> ''\n            RETURNING id, workspace_id, channel_id, thread_parent_id, content,\n                      files_left_behind, updated_at\n            ",
