  "query": "\n            SELECT id, name, enabled, created_by\n              FROM workflows\n             WHERE workspace_id = $1\n               AND (definition #>> '{trigger,channel_id}' = $2\n                    OR definition->'steps' @> jsonb_build_array(\n                         jsonb_build_object('type', 'send_message', 'channel_id', $2::text)))\n             ORDER BY lower(name)\n            ",
