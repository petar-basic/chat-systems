  "query": "\n            SELECT wm.workspace_id, wm.theme AS \"theme!: Json<Theme>\"\n              FROM workspace_members wm\n              JOIN workspaces w ON w.id = wm.workspace_id\n             WHERE wm.user_id = $1 AND wm.theme IS NOT NULL AND w.is_active = true\n            ",
