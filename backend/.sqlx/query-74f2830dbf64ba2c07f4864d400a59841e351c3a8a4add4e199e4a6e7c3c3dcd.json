{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT g.id, g.handle, g.name, g.description,\n                   COUNT(m.user_id) AS \"member_count!\",\n                   BOOL_OR(m.user_id = $2) IS TRUE AS \"is_member!\"\n              FROM user_groups g\n              LEFT JOIN user_group_members m ON m.group_id = g.id\n             WHERE g.workspace_id = $1\n             GROUP BY g.id\n             ORDER BY g.handle\n            ",
