  "query": "INSERT INTO sidebar_sections (user_id, workspace_id, name, position)\n               SELECT $1, $2, $3, COALESCE(MAX(position) + 1, 0)\n                 FROM sidebar_sections WHERE user_id = $1 AND workspace_id = $2\n               RETURNING id, name, position, collapsed",
