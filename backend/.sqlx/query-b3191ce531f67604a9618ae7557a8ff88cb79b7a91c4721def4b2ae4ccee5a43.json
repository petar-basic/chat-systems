  "query": "\n            SELECT id, workspace_id, name, created_by\n              FROM workflows\n             WHERE enabled\n               AND jsonb_path_exists(definition,\n                                     'strict $.**.app_id ? (@ == $a)',\n                                     jsonb_build_object('a', $1::text))\n             ORDER BY lower(name)\n            ",
