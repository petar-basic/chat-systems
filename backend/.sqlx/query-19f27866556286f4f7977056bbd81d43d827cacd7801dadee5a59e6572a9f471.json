  "query": "\n            UPDATE later_items\n               SET reminded_at = NOW()\n             WHERE id IN (\n                 SELECT id FROM later_items\n                  WHERE remind_at <= NOW() AND reminded_at IS NULL AND status = 'in_progress'\n                  ORDER BY remind_at\n                  FOR UPDATE SKIP LOCKED\n                  LIMIT 100\n             )\n            RETURNING id, workspace_id, user_id, channel_id, message_id, text\n            ",
