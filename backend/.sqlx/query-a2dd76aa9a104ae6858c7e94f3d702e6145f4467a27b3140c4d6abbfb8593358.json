  "query": "SELECT c.id, c.item_id, c.list_id, c.user_id, c.content, c.created_at, c.edited_at\n               FROM list_item_comments c\n               JOIN list_items i ON i.id = c.item_id AND i.deleted_at IS NULL\n              WHERE c.list_id = $1\n              ORDER BY c.created_at, c.id",
