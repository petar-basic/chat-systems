  "query": "\n            SELECT cm.channel_id, cm.unread_count, cm.mention_count, cm.last_read_msg\n              FROM channel_members cm\n              JOIN channels c ON c.id = cm.channel_id\n             WHERE c.workspace_id = $1 AND cm.user_id = $2 AND c.is_archived = false\n            ",
