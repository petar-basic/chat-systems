  "query": "\n            SELECT at AS \"at!\", at <= NOW() AS \"due!\",\n                   at > NOW() + make_interval(days => $5) AS \"too_far!\"\n              FROM (SELECT COALESCE(($1::date + $2::time) AT TIME ZONE $3,\n                                    NOW() + make_interval(mins => $4::int)) AS at) w\n            ",
