  "query": "\n            SELECT su.slack_user_id, su.user_id, COALESCE(u.display_name, u.email) AS \"name!\"\n            FROM slack_users su\n            JOIN users u ON u.id = su.user_id\n            WHERE su.workspace_id = $1\n            ",
