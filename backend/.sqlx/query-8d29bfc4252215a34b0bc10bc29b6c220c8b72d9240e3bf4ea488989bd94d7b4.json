  "query": "\n            SELECT id, version, definition, next_run_at AS \"next_run_at!\"\n              FROM workflows\n             WHERE enabled AND next_run_at <= NOW()\n             ORDER BY next_run_at\n             LIMIT $1\n             FOR UPDATE SKIP LOCKED\n            ",
